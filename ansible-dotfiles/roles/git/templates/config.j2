[user]
	name = Joey Buiteweg
	email = joey@joeybuiteweg.com
[push]
	default = simple
[filter "lfs"]
	; required = true
	; clean = git-lfs clean -- %f
	; smudge = git-lfs smudge -- %f
	; process = git-lfs filter-process
[core]
	excludesfile = ~/.config/git/global-gitignore.txt
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default
; [credential]
; 	helper = !aws codecommit credential-helper $@
; 	UseHttpPath = true
[init]
	defaultBranch = main
